# Coverage testing files.
.coverage
/htmlcov

# Environment configuration file.
.env

# Virtual environment files (pipenv may use this convention).
.venv

# IDE configuration files.
/.idea

# Claude AI files
/.claude

# Node development dependencies.
/node_modules

# Python files.
*.pyc

# App static file directories.
/*/static

# Django media root directory.
/media

# Databases and their backups. These hold real activity data, password hashes
# and API tokens, so they must never be committed. `restoredb --output` writes
# into the repository root by default, which is what these patterns catch.
*.sqlite3
*.sqlite3.gz
*.sqlite3.dev-backup

# Server and build logs.
*.log

# Pipfile.lock.
# Committing this file makes it difficult to support multiple Python versions as
# requirements can different between versions, but the Pipfile only supports
# locking to one version.
Pipfile.lock

# Documentation
/site

# macOS files
.DS_Store

# Devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

.vscode